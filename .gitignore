# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
myenv/

# Build artifacts
build/
dist/
*.egg

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local env / secrets
.env
.env.local
*.local

# Model caches and weights (must NEVER be committed)
models/
weights/
*.pt
*.bin
*.safetensors
*.gguf
*.onnx

# Runtime / logs
logs/
*.log
runtime/

# Scratch / dev-only one-shot scripts
scratch/

# Bench result dumps (run-specific, not source)
bench/results-*.json
bench/output/
bench/.videocraft/

# Claude Code session/agent local state — per-developer, not project state
.claude/

# Starlight build artifact: sync-docs.mjs writes docs/public/** into here
# before each `astro build`. Source of truth lives at docs/public/.
site/src/content/docs/
site/dist/
site/node_modules/
site/.astro/

# NOTE: docs/public/api/reference/ is auto-generated by
# scripts/gen_api_reference.py from the FastAPI OpenAPI spec, but we
# DO commit the output. CI (GitHub Actions Deploy Site) does not have
# aistack's Python venv to regenerate during build, so the committed
# files are what gets published. Developer workflow: edit code, run
#   python scripts/gen_api_reference.py
# locally, commit both the code change AND the regenerated reference.
# The site/scripts/sync-docs.mjs prebuild hook regenerates them
# whenever a usable Python interpreter is on PATH; otherwise it falls
# back to whatever is checked in.
