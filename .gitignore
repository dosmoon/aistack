# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
myenv/

# Build artifacts
build/
dist/
*.egg

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local env / secrets
.env
.env.local
*.local

# Model caches and weights (must NEVER be committed)
models/
weights/
*.pt
*.bin
*.safetensors
*.gguf
*.onnx

# Runtime / logs
logs/
*.log
runtime/

# Scratch / dev-only one-shot scripts
scratch/

# Bench result dumps (run-specific, not source)
bench/results-*.json
bench/output/
bench/.videocraft/

# Claude Code session/agent local state — per-developer, not project state
.claude/

# Starlight build artifact: sync-docs.mjs writes docs/public/** into here
# before each `astro build`. Source of truth lives at docs/public/.
site/src/content/docs/
site/dist/
site/node_modules/
site/.astro/

# Auto-generated reference markdown — DO NOT commit.
# scripts/gen_api_reference.py and scripts/gen_config_reference.py
# rewrite these files on every build (locally via sync-docs.mjs's
# prebuild hook; in CI the deploy-site workflow installs aistack and
# the prebuild hook regenerates them fresh before astro build).
# Source of truth: aistack/api/* docstrings + aistack/api/_schemas.py
# + aistack/config.py. Committing build output to source control is
# an anti-pattern that creates a drift surface.
docs/public/api/reference/
docs/public/reference/configuration.md
